; Engine configuration file.
config_version=5

[application]

config/name="Pitch Masters"
config/description="3D футбол на C++: матчи, состав, карточки, лига, патчи и PvP"
config/version="3.2"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon/icon_512.png"
config/quit_on_go_back=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom="res://assets/theme.tres"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=12

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
