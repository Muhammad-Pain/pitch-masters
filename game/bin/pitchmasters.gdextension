[configuration]

entry_symbol = "pitchmasters_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/libpitchmasters.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libpitchmasters.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libpitchmasters.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libpitchmasters.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libpitchmasters.macos.template_debug.universal.dylib"
macos.release = "res://bin/libpitchmasters.macos.template_release.universal.dylib"
android.debug.arm64 = "res://bin/libpitchmasters.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libpitchmasters.android.template_release.arm64.so"
android.debug.arm32 = "res://bin/libpitchmasters.android.template_debug.arm32.so"
android.release.arm32 = "res://bin/libpitchmasters.android.template_release.arm32.so"
